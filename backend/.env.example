# Environment Configuration for Landslide & Weather Risk Early Warning Engine

# Host and Port
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated list for local + deployed frontend on Vercel)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8000,https://*.vercel.app

# OpenTopography API Key (Optional: fallback elevation service used if not provided)
OPENTOPOGRAPHY_API_KEY=

# Database URL (SQLite default - ephemeral on Render free tier, documented in README)
DATABASE_URL=sqlite+aiosqlite:///./landslide_risk.db

# Path to trained LightGBM model artifact
MODEL_PATH=./ml/risk_model.pkl
